{
  "manifest_version": 3,
  "name": "ReelMind Audio Grabber",
  "version": "1.1",
  "description": "Capture clean audio and real metadata directly from Instagram Reels and YouTube Shorts",
  "permissions": [
    "tabCapture",
    "offscreen",
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://*.youtube.com/*",
    "http://localhost:5000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ReelMind Audio Grabber"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*",
        "https://*.youtube.com/*"
      ],
      "js": ["content.js"]
    }
  ]
}
